import requests
from bs4 import BeautifulSoup
import csv
from datetime import datetime
import time

class NewsScraper:
    def __init__(self):
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        self.articles = []
    
    def scrape_bbc_news(self):
        """Scrape top news from BBC News"""
        try:
            url = "https://www.bbc.com/news"
            response = requests.get(url, headers=self.headers, timeout=10)
            response.raise_for_status()
            
            soup = BeautifulSoup(response.content, 'html.parser')
            
            # Find all article headlines
            articles = soup.find_all('h2', limit=10)
            
            for article in articles:
                headline = article.get_text(strip=True)
                if headline:
                    link_elem = article.find_parent('a')
                    link = link_elem.get('href', '') if link_elem else ''
                    if not link.startswith('http'):
                        link = 'https://www.bbc.com' + link
                    
                    self.articles.append({
                        'title': headline,
                        'url': link,
                        'source': 'BBC News',
                        'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                    })
            
            print(f"✓ Scraped {len(self.articles)} articles from BBC News")
            return self.articles
            
        except requests.exceptions.RequestException as e:
            print(f"✗ Error scraping BBC News: {e}")
            return []
    
    def scrape_hacker_news(self):
        """Scrape top stories from Hacker News"""
        try:
            url = "https://news.ycombinator.com/"
            response = requests.get(url, headers=self.headers, timeout=10)
            response.raise_for_status()
            
            soup = BeautifulSoup(response.content, 'html.parser')
            
            # Find story rows
            stories = soup.find_all('tr', class_='athing', limit=10)
            
            for story in stories:
                title_elem = story.find('span', class_='titleline').find('a')
                title = title_elem.get_text(strip=True) if title_elem else 'N/A'
                url = title_elem.get('href', '') if title_elem else ''
                
                self.articles.append({
                    'title': title,
                    'url': url,
                    'source': 'Hacker News',
                    'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                })
            
            print(f"✓ Scraped {len(self.articles)} articles from Hacker News")
            return self.articles
            
        except requests.exceptions.RequestException as e:
            print(f"✗ Error scraping Hacker News: {e}")
            return []
    
    def save_to_csv(self, filename='news_articles.csv'):
        """Save scraped articles to CSV file"""
        if not self.articles:
            print("✗ No articles to save")
            return False
        
        try:
            with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
                fieldnames = ['title', 'url', 'source', 'timestamp']
                writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
                writer.writeheader()
                writer.writerows(self.articles)
            
            print(f"✓ Saved {len(self.articles)} articles to {filename}")
            return True
            
        except Exception as e:
            print(f"✗ Error saving to CSV: {e}")
            return False
    
    def display_articles(self):
        """Display scraped articles in console"""
        if not self.articles:
            print("No articles to display")
            return
        
        print("\n" + "="*80)
        print(f"SCRAPED ARTICLES ({len(self.articles)} total)")
        print("="*80 + "\n")
        
        for i, article in enumerate(self.articles, 1):
            print(f"{i}. {article['title']}")
            print(f"   Source: {article['source']}")
            print(f"   URL: {article['url']}")
            print(f"   Time: {article['timestamp']}\n")


def main():
    scraper = NewsScraper()
    
    print("Starting News Scraper...\n")
    
    # Scrape from Hacker News (more reliable than BBC without authentication)
    print("Scraping Hacker News...")
    scraper.scrape_hacker_news()
    
    # Display articles
    scraper.display_articles()
    
    # Save to CSV
    scraper.save_to_csv('scraped_news.csv')


if __name__ == "__main__":
    main()
